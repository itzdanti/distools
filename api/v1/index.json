            },
            {
              "name": "integer",
              "in": "body",
              "type": "string",
              "description": "Decimal, 0x hex or 0b binary integer."
            }
          ]
        },
        {
          "id": "permissions.list",
          "method": "GET",
          "path": "/api/v1/permissions/all",
          "group": "Permissions",
          "summary": "Every permission with its bit",
          "tools": [
            "permission-calculator"
          ],
          "params": []
        }
      ]
    },
