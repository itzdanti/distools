            {
              "name": "hex",
              "in": "body",
              "type": "string",
              "description": "Colour as a hex string.",
              "required": true,
              "example": "#5865f2"
            },
            {
              "name": "mode",
              "in": "body",
              "type": "string",
              "description": "embed for the payload a bot posts, blocks for the decoration.",
              "default": "embed",
              "enum": [
                "embed",
                "blocks"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Developer",
      "endpoints": [
        {
          "id": "codecs.base64",
          "method": "GET",
          "path": "/api/v1/base64",
          "group": "Developer",
          "summary": "Base64 encode or decode",
          "tools": [
            "base64"
          ],
          "params": [
            {
              "name": "input",
              "in": "body",
              "type": "string",
              "description": "Value to convert.",
              "required": true,
              "example": "hello"
            },
            {
              "name": "mode",
              "in": "body",
              "type": "string",
              "description": "encode, decode, encodeUrl or decodeUrl.",
              "default": "encode",
              "enum": [
                "encode",
                "decode",
                "encodeUrl",
                "decodeUrl"
              ]
            }
          ]
        },
        {
          "id": "codecs.url",
          "method": "GET",
          "path": "/api/v1/url",
          "group": "Developer",
          "summary": "Percent-encode or decode a URL component",
          "tools": [
