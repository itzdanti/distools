          "id": "emoji.categories",
          "method": "GET",
          "path": "/api/v1/emojis/categories",
          "group": "Emoji",
          "summary": "List emoji categories",
          "tools": [
            "emoji-library"
          ],
          "params": []
        },
        {
          "id": "emoji.color-text",
          "method": "GET",
          "path": "/api/v1/emoji/color-text",
          "group": "Emoji",
          "summary": "Get coloured text, or find out why you cannot",
